rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras de acesso para o CRM e gestão da clínica
    match /leads/{leadId} {
      allow read, write: if true;
    }
    match /fichas/{fichaId} {
      allow read, write: if true;
    }
    match /compras/{compraId} {
      allow read, write: if true;
    }
    match /procedimentos/{procedimentoId} {
      allow read, write: if true;
    }
    match /usuarios/{usuarioId} {
      allow read, write: if true;
    }
    match /empresas/{empresaId} {
      allow read, write: if true;
    }
    match /empresa_membros/{membroId} {
      allow read, write: if true;
    }
    match /plataforma_admins/{adminId} {
      allow read, write: if true;
    }
    match /configuracoes/{configId} {
      allow read, write: if true;
    }
    match /configuracoes_sistema/{docId} {
      allow read, write: if true;
    }
  }
}

